<templates id="template" xml:space="preserve">
  <t t-name="PaymentScreenPaymentLinesCryptoPatch"
     t-inherit="point_of_sale.PaymentScreenPaymentLines"
     t-inherit-mode="extension"
     owl="1">

    <!-- Find the block that wraps all the payment_status conditionals -->
    <xpath expr="//t[@t-if='line and line.payment_status']" position="inside">
      <t t-if="line.payment_status == 'cryptowaiting'">
        <div class="paymentline electronic_payment">
          <div class="electronic_status">
            <t t-esc="line.crypto_payment_status"/>
          </div>
                 <div class="button show_receipt highlight" title="Show receipt" t-on-click="() => this.pos.clickShowReceipt()">
                    Show receipt
                </div>
        </div>
      </t>
    </xpath>

  </t>
</templates>
